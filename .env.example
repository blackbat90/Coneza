# Public Host Port (avoiding ports 80, 443, and 8080)
BACKEND_PORT=9080

# Google Gemini API Key (for E8/E9/SLD document analysis)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (for Hybrid Multi-Model Cross-Evaluation with GPT-4o)
# Obtain from https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Secret key for JWT session tokens & authentication
CONEZA_JWT_SECRET=coneza-super-secret-jwt-key-2026-vde4110
